PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/athr
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=30d
CORS_ORIGIN=*

# Sign in with Google: comma-separated list of every OAuth client ID your
# clients present (web, iOS, Android) — verifyIdToken accepts any of these
# as a valid audience. Create them at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_IDS=

# Sign in with Apple: the audience Apple puts in the identity token — your
# app's bundle identifier for a native app (e.g. app.athr.mobile), or your
# Services ID if you also sign in from the web. Configure at
# https://developer.apple.com/account/resources/identifiers/list/serviceId
APPLE_CLIENT_ID=
