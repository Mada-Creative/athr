{
  "expo": {
    "name": "أثر",
    "slug": "athr",
    "scheme": "athr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF5EC"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.athr.mobile",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "نستخدم موقعك لحساب مواعيد الصلاة واتجاه القبلة بدقة.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.athr.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#FAF5EC"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "extra": {
      "apiBaseUrl": "https://safe-citadel-95574-87a79d0291e7.herokuapp.com/api",
      "eas": {
        "projectId": "5d0dcaf0-6f42-47ce-831f-a498f1c70478"
      }
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser",
      "expo-apple-authentication"
    ]
  }
}